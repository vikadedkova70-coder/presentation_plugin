# --- Google Drive ---
# ВАРИАНТ 1 (рекомендуется для обычного Gmail): OAuth. Значения даёт scripts/get_refresh_token.py
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# ВАРИАНТ 2: сервисный аккаунт (работает только с Общим диском, нужен Google Workspace)
# Вариант 1 (локально): путь к JSON-ключу сервисного аккаунта
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/sa.json
# Вариант 2 (хостинг): весь JSON одной строкой
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_MAKE_PUBLIC=false

# Режим заглушки: Drive не вызывается, возвращается фейковая ссылка (для Показа 2 и фронтенда)
DRIVE_STUB=true

# --- Сервер ---
MAX_UPLOAD_MB=100
DB_PATH=./slidoteka.db
CORS_ORIGINS=https://localhost:3000
# Если задан — GET /api/exports требует заголовок X-Admin-Token
ADMIN_TOKEN=

# --- Деплой (docker compose) ---
DOMAIN=slidoteka-team.duckdns.org
